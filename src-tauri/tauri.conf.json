{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Share",
  "mainBinaryName": "simple-share",
  "identifier": "dev.simpleshare.app",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Simple Share",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Send and receive files with any phone, securely",
    "longDescription": "Simple Share lets any phone on your network send files to this computer and download files from it, in the browser, with no app to install. Every phone needs your approval, connections are encrypted, and phones you pair get a verified connection.",
    "copyright": "Simple Share contributors",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2OTgzRDA4NjFBNzlDMDQKUldRRW5LZGhDRDJZZHUxb3FXOHBybGxjSW03ZDFETC9KckdIT21kWnFTMmxMMG0zYjhCb0pPckwK",
      "endpoints": [
        "https://github.com/fleetwoodjohnr/simple-share/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
